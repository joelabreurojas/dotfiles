# tmux — Omarchy ergonomic config
# Prefix: Ctrl+Space (C-Space) — Ctrl+B stays unbound for editor use

# Prefix
set -g prefix C-Space
unbind C-b

# History and indexing
set -g history-limit 50000
set -g base-index 1
set -w pane-base-index 1
set -w renumber-windows on

# Terminal and colors
set -g default-terminal "tmux-256color"
set -ga terminal-overrides ",xterm-256color:RGB"
set -g mouse on
set -s escape-time 10

# Vim-style pane navigation (no prefix)
bind -n C-h select-pane -L
bind -n C-j select-pane -D
bind -n C-k select-pane -U
bind -n C-l select-pane -R

# Splits open in the current pane's directory
bind "|" split-window -h -c "#{pane_current_path}"
bind "-" split-window -v -c "#{pane_current_path}"

# Session picker (fuzzy session switcher)
bind C-f choose-tree -Zs

# Reload config
bind r source-file "{{ .chezmoi.homeDir }}/.config/tmux/tmux.conf"
