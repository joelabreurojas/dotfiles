# Alacritty — Omarchy terminal, Everforest Dark Soft
# Font: JetBrainsMono NFP (delivered via .chezmoiexternals/fonts.toml.tmpl)

[env]
TERM = "xterm-256color"

[window]
padding = { x = 4, y = 4 }

[font]
size = 12.0

[font.normal]
family = "JetBrainsMono Nerd Font Propo"
style = "Regular"

[font.bold]
family = "JetBrainsMono Nerd Font Propo"
style = "Bold"

[font.italic]
family = "JetBrainsMono Nerd Font Propo"
style = "Italic"

[colors.primary]
background = "#2d353b"
foreground = "#d3c6aa"
dim_foreground = "#859289"
bright_foreground = "#d3c6aa"

[colors.cursor]
text = "#2d353b"
cursor = "#d3c6aa"

[colors.normal]
black = "#252c32"
red = "#e67e80"
green = "#a7c080"
yellow = "#dbbc7f"
blue = "#7fbbb3"
magenta = "#d699b6"
cyan = "#83c092"
white = "#d3c6aa"

[colors.bright]
black = "#859289"
red = "#e67e80"
green = "#a7c080"
yellow = "#dbbc7f"
blue = "#7fbbb3"
magenta = "#d699b6"
cyan = "#83c092"
white = "#d3c6aa"
