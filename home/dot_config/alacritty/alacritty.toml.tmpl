# Alacritty — Omarchy terminal, Nord
# Font: JetBrainsMono NFP (delivered via .chezmoiexternals/fonts.toml.tmpl)

[env]
TERM = "xterm-256color"

[window]
padding = { x = 4, y = 4 }

[font]
size = 12.0

[font.normal]
family = "JetBrainsMono Nerd Font Propo"
style = "Regular"

[font.bold]
family = "JetBrainsMono Nerd Font Propo"
style = "Bold"

[font.italic]
family = "JetBrainsMono Nerd Font Propo"
style = "Italic"

[colors.primary]
background = "#2e3440"
foreground = "#d8dee9"
dim_foreground = "#4c566a"
bright_foreground = "#d8dee9"

[colors.cursor]
text = "#2e3440"
cursor = "#d8dee9"

[colors.normal]
black = "#222730"
red = "#bf616a"
green = "#a3be8c"
yellow = "#ebcb8b"
blue = "#81a1c1"
magenta = "#b48ead"
cyan = "#88c0d0"
white = "#d8dee9"

[colors.bright]
black = "#4c566a"
red = "#bf616a"
green = "#a3be8c"
yellow = "#ebcb8b"
blue = "#81a1c1"
magenta = "#b48ead"
cyan = "#8fbcbb"
white = "#d8dee9"
